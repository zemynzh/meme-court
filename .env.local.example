# AI Provider Configuration
# Copy this file to .env.local and fill in your values

# Base URL of your AI provider (OpenAI-compatible endpoint)
# Examples:
#   OpenAI:  https://api.openai.com/v1
#   Xiaomi:  https://token-plan-sgp.xiaomimimo.com/v1
AI_API_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1

# Your API key
AI_API_KEY=your_xiaomi_api_key_here

# Model name (all lowercase)
# Examples:
#   OpenAI:  gpt-4o, gpt-4o-mini
#   Xiaomi:  mimo-v2.5-pro
AI_MODEL=mimo-v2.5-pro
